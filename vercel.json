{
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat.js"
    },
    {
      "source": "/api/search",
      "destination": "/api/search.js"
    },
    {
      "source": "/browse",
      "destination": "/public/browse/index.html"
    },
    {
      "source": "/browse/(.*)",
      "destination": "/public/browse/$1"
    },
    {
      "source": "/chat",
      "destination": "/public/chat/index.html"
    },
    {
      "source": "/chat/(.*)",
      "destination": "/public/chat/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/public/chat/assets/$1"
    },
    {
      "source": "/",
      "destination": "/public/chat/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}